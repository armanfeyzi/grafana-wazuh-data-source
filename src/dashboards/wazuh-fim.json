      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "dataType": "fim",
          "format": "stat",
          "filters": { "agentNames": ["$agent"] }
        }
      ],
      "title": "FIM events in range",
      "type": "stat"
    },
    {
      "datasource": { "type": "wazuh-datasource", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" }
        }
      },
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        {
          "refId": "A",
          "dataType": "fim",
          "format": "time_series",
          "filters": { "agentNames": ["$agent"] }
        }
      ],
      "title": "FIM events over time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "wazuh-datasource", "uid": "${datasource}" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "options": { "showHeader": true, "sortBy": [{ "desc": true, "displayName": "Time" }] },
      "targets": [
        {
          "refId": "A",
          "dataType": "fim",
          "format": "table",
          "limit": 100,
          "filters": { "agentNames": ["$agent"] }
        }
      ],
      "title": "Recent file integrity changes",
      "type": "table"
    }
