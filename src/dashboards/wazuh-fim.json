  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["wazuh", "fim"],
  "templating": {
    "list": [
      {
        "label": "Datasource",
        "name": "datasource",
        "query": "wazuh-datasource",
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "includeAll": true,
        "label": "Agent",
        "multi": true,
        "name": "agent",
        "query": "fedora,wazuh.manager",
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
