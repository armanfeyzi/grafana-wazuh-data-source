{
  "annotations": {
    "list": []
  },
  "description": "Example: Prometheus node metrics and Wazuh security alerts on the same dashboard, linked by the $agent variable. Set your Prometheus datasource UID to 'prometheus' (or update the panel datasource UIDs below).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "Infrastructure — Node CPU",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "CPU utilisation (user+system) on nodes matching the selected agent name. Requires your Prometheus datasource UID to be 'prometheus'.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (instance) (rate(node_cpu_seconds_total{mode!=\"idle\", instance=~\"$agent.*\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "Node CPU usage — $agent",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Memory usage on nodes matching the selected agent name.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "node_memory_MemTotal_bytes{instance=~\"$agent.*\"} - node_memory_MemAvailable_bytes{instance=~\"$agent.*\"}",
          "legendFormat": "{{instance}} used",
          "refId": "A"
        }
      ],
      "title": "Node memory usage — $agent",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 11,
      "title": "Security — Wazuh Alerts",
      "type": "row"
    },
    {
      "datasource": {
        "type": "armanfeyzi-wazuh-datasource",
        "uid": "wazuh"
      },
      "description": "Wazuh security alert rate for the same agent selected above. High spikes here while CPU is also spiking can indicate a compromise or noisy process.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "id": 3,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "dataType": "alerts",
          "format": "time_series",
          "filters": {
            "agentNames": ["$agent"]
          }
        }
      ],
      "title": "Wazuh alerts over time — $agent",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "armanfeyzi-wazuh-datasource",
        "uid": "wazuh"
      },
      "description": "Recent Wazuh alerts for the selected agent — correlate with the CPU/memory panels above.",
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "severity_level" },
            "properties": [
              {
                "id": "custom.width",
                "value": 80
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 7 },
                    { "color": "red", "value": 12 }
                  ]
                }
              },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "id": 4,
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Time" }]
      },
      "targets": [
        {
          "refId": "A",
          "dataType": "alerts",
          "format": "table",
          "limit": 25,
          "filters": {
            "agentNames": ["$agent"]
          }
        }
      ],
      "title": "Recent Wazuh alerts — $agent",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 12,
      "title": "Kubernetes — Namespace View",
      "type": "row"
    },
    {
      "datasource": {
        "type": "armanfeyzi-wazuh-datasource",
        "uid": "wazuh"
      },
      "description": "Wazuh alerts filtered to the selected Kubernetes namespace. Requires Wazuh k8s integration (kubernetes.namespace field in alerts).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "never"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "dataType": "alerts",
          "format": "time_series",
          "filters": {
            "ruleGroups": ["kubernetes"]
          }
        }
      ],
      "title": "Kubernetes-related Wazuh alerts over time (namespace: $namespace)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["wazuh", "prometheus", "correlation", "kubernetes"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "armanfeyzi-wazuh-datasource",
          "uid": "wazuh"
        },
        "definition": "agents",
        "hide": 0,
        "includeAll": true,
        "label": "Agent / Node",
        "multi": false,
        "name": "agent",
        "options": [],
        "query": "agents",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "armanfeyzi-wazuh-datasource",
          "uid": "wazuh"
        },
        "definition": "namespaces",
        "hide": 0,
        "includeAll": true,
        "label": "Namespace",
        "multi": false,
        "name": "namespace",
        "options": [],
        "query": "namespaces",
        "refresh": 1,
        "regex": "",
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Wazuh — Correlation with Prometheus",
  "uid": "wazuh-mixed-prometheus-example",
  "version": 1
}
