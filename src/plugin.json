{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Wazuh",
  "id": "armanfeyzi-wazuh-datasource",
  "metrics": true,
  "backend": true,
  "executable": "gpx_datasource",
  "info": {
    "description": "Connect Grafana to Wazuh (SIEM/XDR) — query alerts, vulnerabilities, FIM events, SCA compliance scores, and agent status without manual OpenSearch configuration.",
    "author": {
      "name": "armanfeyzi"
    },
    "keywords": [
      "datasource",
      "wazuh",
      "security",
      "siem",
      "xdr",
      "opensearch",
      "fim",
      "sca"
    ],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [],
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=10.4.0",
    "plugins": []
  },
  "includes": [
    {
      "type": "dashboard",
      "name": "Security Overview",
      "path": "dashboards/wazuh-security-overview.json",
      "addToNav": true
    },
    {
      "type": "dashboard",
      "name": "Vulnerabilities",
      "path": "dashboards/wazuh-vulnerabilities.json",
      "addToNav": true
    },
    {
      "type": "dashboard",
      "name": "File Integrity (FIM)",
      "path": "dashboards/wazuh-fim.json",
      "addToNav": true
    },
    {
      "type": "dashboard",
      "name": "Security Configuration (SCA)",
      "path": "dashboards/wazuh-sca.json",
      "addToNav": true
    },
    {
      "type": "dashboard",
      "name": "Agent Status",
      "path": "dashboards/wazuh-agent-status.json",
      "addToNav": true
    },
    {
      "type": "dashboard",
      "name": "Correlation with Prometheus (Example)",
      "path": "dashboards/wazuh-mixed-example.json",
      "addToNav": true
    }
  ]
}