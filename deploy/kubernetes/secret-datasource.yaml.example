# Copy to secret-datasource.yaml, fill in values, then: kubectl apply -f secret-datasource.yaml
# Do not commit real credentials.

apiVersion: v1
kind: Secret
metadata:
  name: grafana-wazuh-datasource
  namespace: monitoring
type: Opaque
stringData:
  WAZUH_API_PASSWORD: change-me
  WAZUH_INDEXER_PASSWORD: change-me
